# Local development
NODE_ENV=development
PORT=8080
TZ=America/Mexico_City

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Telegram private alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HUMAN_PAUSE_HOURS=2
TELEGRAM_ALERT_DEDUP_MINUTES=30
# Mantener false en producción para minimizar datos fuera de WhatsApp.
TELEGRAM_INCLUDE_MESSAGE=false

# Meta / WhatsApp (leave blank until production integration)
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v25.0

# Conversation state
# Use memory locally; firestore in Cloud Run production.
STATE_BACKEND=memory
GCP_PROJECT_ID=asistente-consultorio-cg
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=whatsapp_conversations
STATE_RETENTION_DAYS=90

# Calendar IDs
DOCTOR_CALENDAR_ID=dr.cristopher.gonzalez@gmail.com
MEXICO_AMERICANO_CALENDAR_ID=consultoriomexicoamericano@gmail.com
SAN_SERAFIN_CALENDAR_ID=consultoriosanserafin@gmail.com
